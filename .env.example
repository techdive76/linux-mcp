# ── Host-side settings for docker-compose.yml / docker-compose.prod.yml ────
# Copy to .env and adjust:  cp .env.example .env
# Client API keys live in config/clients.yaml (generate with: python -m linux_mcp.auth)

# Image used by docker-compose.prod.yml (published by .github/workflows/ci.yml)
APP_IMAGE=ghcr.io/techdive76/linux-mcp:latest

# Port published on the Docker host (the container always listens on 8000)
HOST_PORT=8000

# Host directories mounted into the container (read-only)
CONFIG_DIR=./config
SSH_DIR=./ssh

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For / X-Real-IP headers are trusted.
# Leave empty if clients connect directly. Include the Docker bridge gateway if the proxy runs on the host.
TRUSTED_PROXIES=

# true = reject SSH hosts not present in ${SSH_DIR}/known_hosts
SSH_STRICT_HOST_KEYS=false

LOG_LEVEL=INFO

# Access log format: json = structured access events (client alias, real client IP, duration)
#                    plain = uvicorn's standard access log. Command audit logs are JSON either way.
ACCESS_LOG_FORMAT=json

# Max characters of stdout/stderr written to the audit log per command (0 = no limit)
LOG_MAX_OUTPUT_CHARS=10000
